{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kino-pic-cloudflare-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "APP_ENV": "local",
    "APP_URL": "http://127.0.0.1:8787",
    "REGISTRATION_MODE": "closed",
    "STORAGE_AUTODELETE_ENABLED": "false",
    "STORAGE_RETENTION_DRY_RUN": "true",
    "MULTI_ACCOUNT_STORAGE_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kino-pic-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRIMARY_STORAGE",
      "bucket_name": "kino-pic-local-private",
    },
  ],
  "env": {
    "staging": {
      "name": "kino-pic-staging",
      "workers_dev": false,
      "vars": {
        "APP_ENV": "staging",
        "APP_URL": "https://configure-staging.invalid",
        "REGISTRATION_MODE": "closed",
        "STORAGE_AUTODELETE_ENABLED": "false",
        "STORAGE_RETENTION_DRY_RUN": "true",
        "MULTI_ACCOUNT_STORAGE_ENABLED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kino-pic-staging",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIMARY_STORAGE",
          "bucket_name": "kino-pic-staging-private",
        },
      ],
      "triggers": {
        "crons": ["0 0 * * *"],
      },
    },
    "production": {
      "name": "kino-pic-production",
      "workers_dev": false,
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://configure-production.invalid",
        "REGISTRATION_MODE": "closed",
        "STORAGE_AUTODELETE_ENABLED": "false",
        "STORAGE_RETENTION_DRY_RUN": "true",
        "MULTI_ACCOUNT_STORAGE_ENABLED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kino-pic-production",
          "database_id": "00000000-0000-4000-8000-000000000003",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIMARY_STORAGE",
          "bucket_name": "kino-pic-production-private",
        },
      ],
      "triggers": {
        "crons": ["0 0 * * *"],
      },
    },
  },
}
