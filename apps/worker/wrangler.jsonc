{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kino-pic-cloudflare-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": ".static",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "APP_ENV": "local",
    "APP_URL": "http://127.0.0.1:8787",
    "REGISTRATION_MODE": "closed",
    "STORAGE_AUTODELETE_ENABLED": "false",
    "STORAGE_RETENTION_DRY_RUN": "true",
    "MULTI_ACCOUNT_STORAGE_ENABLED": "false",
    "DIRECT_UPLOAD_ENABLED": "false",
    "GUEST_INVITE_ISSUANCE_ENABLED": "false",
    "GUEST_EXCHANGE_ENABLED": "false",
    "GUEST_SELECTION_ENABLED": "false",
    "GUEST_FEEDBACK_ENABLED": "false",
    "GUEST_TAGS_ENABLED": "false",
    "GUEST_HISTORY_ENABLED": "false",
    "HUMAN_VIEW_TRACKING_ENABLED": "false",
    "CLIENT_ACTIVITY_ENABLED": "true",
    "VERSION_APPROVALS_ENABLED": "false",
    "GUEST_DOWNLOADS_ENABLED": "false",
    "GUEST_VERSION_COMPARISON_ENABLED": "false",
    "GUEST_COMMENTS_ENABLED": "false",
    "GUEST_ANNOTATIONS_ENABLED": "false",
    "FREEHAND_ANNOTATIONS_ENABLED": "false",
    "OWNER_COMMENTS_ENABLED": "false",
    "OWNER_ANNOTATIONS_ENABLED": "false",
    "OWNER_ANNOTATION_AUTHORING_ENABLED": "false",
    "OWNER_ANNOTATION_PROCESSING_ENABLED": "false",
    "MATCHING_RULES_ENABLED": "false",
    "RESOLVED_BATCH_UPLOAD_ENABLED": "false",
    "ASSISTED_CANDIDATE_CATALOG_ENABLED": "false",
    "INDEXED_VERSION_MATCHING_ENABLED": "false",
    "MATCHING_FILENAME_INDEX_ENABLED": "false",
    "OWNER_HISTORY_ENABLED": "false",
    "OWNER_COMMENT_PROCESSING_ENABLED": "false",
    "PHOTO_VERSIONS_ENABLED": "false",
    "PHOTO_VERSION_UPLOADS_ENABLED": "false",
    "PHOTO_VERSION_MATCHING_ENABLED": "false",
    "PROJECT_VERSIONING_CONFIGURATION_ENABLED": "false",
    "GUEST_SHARED_SELECTION_ENABLED": "false",
    "R2_BUCKET_NAME": "kino-pic-local-private",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kino-pic-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRIMARY_STORAGE",
      "bucket_name": "kino-pic-local-private",
    },
  ],
  "env": {
    "staging": {
      "name": "kino-pic-staging",
      "workers_dev": false,
      "vars": {
        "APP_ENV": "staging",
        "APP_URL": "https://kino-pic-staging.kino-pick-aaron2026.workers.dev",
        "REGISTRATION_MODE": "closed",
        "STORAGE_AUTODELETE_ENABLED": "false",
        "STORAGE_RETENTION_DRY_RUN": "true",
        "MULTI_ACCOUNT_STORAGE_ENABLED": "false",
        "DIRECT_UPLOAD_ENABLED": "false",
        "GUEST_INVITE_ISSUANCE_ENABLED": "false",
        "GUEST_EXCHANGE_ENABLED": "false",
        "GUEST_SELECTION_ENABLED": "false",
        "GUEST_FEEDBACK_ENABLED": "false",
        "GUEST_TAGS_ENABLED": "false",
        "GUEST_HISTORY_ENABLED": "false",
        "HUMAN_VIEW_TRACKING_ENABLED": "false",
        "CLIENT_ACTIVITY_ENABLED": "false",
        "VERSION_APPROVALS_ENABLED": "false",
        "GUEST_DOWNLOADS_ENABLED": "false",
        "GUEST_VERSION_COMPARISON_ENABLED": "false",
        "GUEST_COMMENTS_ENABLED": "false",
        "GUEST_ANNOTATIONS_ENABLED": "false",
        "FREEHAND_ANNOTATIONS_ENABLED": "false",
        "OWNER_COMMENTS_ENABLED": "false",
        "OWNER_ANNOTATIONS_ENABLED": "false",
        "OWNER_ANNOTATION_AUTHORING_ENABLED": "false",
        "OWNER_ANNOTATION_PROCESSING_ENABLED": "false",
        "MATCHING_RULES_ENABLED": "false",
        "RESOLVED_BATCH_UPLOAD_ENABLED": "false",
        "ASSISTED_CANDIDATE_CATALOG_ENABLED": "false",
        "INDEXED_VERSION_MATCHING_ENABLED": "false",
        "MATCHING_FILENAME_INDEX_ENABLED": "false",
        "OWNER_HISTORY_ENABLED": "false",
        "OWNER_COMMENT_PROCESSING_ENABLED": "false",
        "PHOTO_VERSIONS_ENABLED": "false",
        "PHOTO_VERSION_UPLOADS_ENABLED": "false",
        "PHOTO_VERSION_MATCHING_ENABLED": "false",
        "PROJECT_VERSIONING_CONFIGURATION_ENABLED": "false",
        "GUEST_SHARED_SELECTION_ENABLED": "false",
        "R2_BUCKET_NAME": "kino-pick-staging-d3e93046",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kino-pick-staging-d3e93046",
          "database_id": "cdee0ac7-bf91-4852-9c17-a996c0b84f8d",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIMARY_STORAGE",
          "bucket_name": "kino-pick-staging-d3e93046",
        },
      ],
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
    },
    "production": {
      "name": "kino-pick-production",
      "account_id": "d3e930465c0df7e89b35de3ca65ea36a",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "APP_ENV": "production",
        "PRODUCTION_RELEASE_ENABLED": "true",
        "STAGING_GUEST_VALIDATION": "false",
        "STAGING_COLLABORATION_VALIDATION": "false",
        "CLOUDFLARE_IMAGE_PROCESSING_ENABLED": "true",
        "ORACLE_STORAGE_ENABLED": "true",
        "ORACLE_STORAGE_ENDPOINT": "https://drive.kinostudio.tw",
        "ORACLE_STORAGE_REGION": "us-east-1",
        "ORACLE_STORAGE_BUCKET": "kino-pick-overflow",
        "ORACLE_STORAGE_ADMIN_USER_ID": "c9561837-8400-4262-9cb3-7b989dd9f76d",
        "ALBUM_ACTIVATION_ENABLED": "true",
        "PHOTOGRAPHER_RECOMMENDATIONS_ENABLED": "true",
        "APPROVED_DELIVERIES_ENABLED": "true",
        "DELIVERY_ZIP_ENABLED": "true",
        "APP_URL": "https://pick.kinostudio.tw",
        "REGISTRATION_MODE": "closed",
        "STORAGE_AUTODELETE_ENABLED": "false",
        "STORAGE_RETENTION_DRY_RUN": "true",
        "MULTI_ACCOUNT_STORAGE_ENABLED": "false",
        "CLIENT_ACTIVITY_ENABLED": "true",
        "DIRECT_UPLOAD_ENABLED": "true",
        "GUEST_INVITE_ISSUANCE_ENABLED": "true",
        "GUEST_EXCHANGE_ENABLED": "true",
        "GUEST_SELECTION_ENABLED": "true",
        "GUEST_FEEDBACK_ENABLED": "true",
        "GUEST_TAGS_ENABLED": "true",
        "GUEST_HISTORY_ENABLED": "true",
        "HUMAN_VIEW_TRACKING_ENABLED": "false",
        "VERSION_APPROVALS_ENABLED": "true",
        "GUEST_DOWNLOADS_ENABLED": "true",
        "GUEST_VERSION_COMPARISON_ENABLED": "true",
        "GUEST_COMMENTS_ENABLED": "true",
        "GUEST_ANNOTATIONS_ENABLED": "true",
        "FREEHAND_ANNOTATIONS_ENABLED": "true",
        "OWNER_COMMENTS_ENABLED": "true",
        "OWNER_ANNOTATIONS_ENABLED": "true",
        "OWNER_ANNOTATION_AUTHORING_ENABLED": "true",
        "OWNER_ANNOTATION_PROCESSING_ENABLED": "true",
        "MATCHING_RULES_ENABLED": "false",
        "RESOLVED_BATCH_UPLOAD_ENABLED": "false",
        "ASSISTED_CANDIDATE_CATALOG_ENABLED": "false",
        "INDEXED_VERSION_MATCHING_ENABLED": "false",
        "MATCHING_FILENAME_INDEX_ENABLED": "false",
        "OWNER_HISTORY_ENABLED": "true",
        "OWNER_COMMENT_PROCESSING_ENABLED": "true",
        "PHOTO_VERSIONS_ENABLED": "true",
        "PHOTO_VERSION_UPLOADS_ENABLED": "true",
        "PHOTO_VERSION_MATCHING_ENABLED": "false",
        "PROJECT_VERSIONING_CONFIGURATION_ENABLED": "true",
        "GUEST_SHARED_SELECTION_ENABLED": "false",
        "R2_ACCOUNT_ID": "d3e930465c0df7e89b35de3ca65ea36a",
        "R2_BUCKET_NAME": "kino-pick-production",
      },
      "images": { "binding": "IMAGES" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kino-pick-production-live",
          "database_id": "65d2286e-f2ac-4ad2-90e2-4b31e2f24251",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIMARY_STORAGE",
          "bucket_name": "kino-pick-production",
        },
      ],
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
    },
  },
}
