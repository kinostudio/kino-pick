# Local app; production release remains blocked until storage/release gates pass.
APP_ENV=local
APP_URL=http://localhost:3000
# disabled by default; supabase requires both values below.
AUTH_DRIVER=disabled
# Enable only providers configured in Supabase. Default without this value: google.
AUTH_PROVIDERS=google,github
# Also requires Supabase manual linking to be explicitly enabled.
AUTH_MANUAL_LINKING_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# No service-role key is used by this application.
STORAGE_DRIVER=memory
STORAGE_SOFT_QUOTA_BYTES=8000000000
STORAGE_RETENTION_DRY_RUN=true
STORAGE_AUTODELETE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ORIGINALS_BUCKET=kino-pic-originals
R2_DERIVATIVES_BUCKET=kino-pic-derivatives
# Migration runner reads from shell, not apps/web/.env.local.
DATABASE_URL=

# Cloudflare target secrets use apps/worker/.dev.vars.example, not this legacy Web env.
# closed registration and destructive-storage defaults are defined in apps/worker/wrangler.jsonc.

# Enable only after processing migration and hosted staging acceptance.
CLOUDFLARE_IMAGE_PROCESSING_ENABLED=false
