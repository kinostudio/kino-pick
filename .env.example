# Local app; production release remains blocked until storage/release gates pass.
APP_ENV=local
APP_URL=http://localhost:3000
# disabled by default; supabase requires both values below.
AUTH_DRIVER=disabled
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# No service-role key is used by this application.
STORAGE_DRIVER=memory
STORAGE_SOFT_QUOTA_BYTES=8000000000
STORAGE_RETENTION_DRY_RUN=true
STORAGE_AUTODELETE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ORIGINALS_BUCKET=kino-pic-originals
R2_DERIVATIVES_BUCKET=kino-pic-derivatives
# Migration runner reads from shell, not apps/web/.env.local.
DATABASE_URL=
