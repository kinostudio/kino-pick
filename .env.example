APP_ENV=local
# Local/test only. Production storage/auth is not implemented.
STORAGE_DRIVER=memory
STORAGE_SOFT_QUOTA_BYTES=8000000000
STORAGE_RETENTION_DRY_RUN=true
STORAGE_AUTODELETE_ENABLED=false
# Copy to apps/web/.env.local for future web integrations. Never commit values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ORIGINALS_BUCKET=kino-pic-originals
R2_DERIVATIVES_BUCKET=kino-pic-derivatives
# Migration runner reads DATABASE_URL from shell, not a committed file.
DATABASE_URL=
