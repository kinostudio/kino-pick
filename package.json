{
  "name": "kino-pic",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @kino-pic/web dev",
    "build": "pnpm --filter @kino-pic/web build",
    "start": "pnpm --filter @kino-pic/web start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @kino-pic/worker types && tsc --noEmit -p tsconfig.json && pnpm --filter @kino-pic/web typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "node tools/migrate.mjs",
    "image:process:local": "node packages/image-processing/src/cli.mjs",
    "image:process:pending:local": "pnpm --filter @kino-pic/worker image:process:pending:local",
    "dev:cloudflare": "pnpm --filter @kino-pic/worker dev",
    "build:cloudflare": "pnpm --filter @kino-pic/worker build",
    "test:cloudflare": "pnpm --filter @kino-pic/worker test",
    "release:inventory": "node tools/release-inventory.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "type": "module"
}
